{
  "name": "devops-ibooking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @ibooking/shared-types build && pnpm -r --parallel --filter api --filter web-admin --if-present dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "db:migrate:dev": "pnpm --filter api db:migrate:dev",
    "openapi:export": "pnpm --filter api openapi:export",
    "story:trace": "node scripts/check-story-trace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.17.6",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.11.0"
  }
}
