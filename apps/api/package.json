{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint src test --ext .ts",
    "test": "pnpm run prisma:generate && jest --config jest.config.ts",
    "test:e2e": "jest --config jest.config.ts --testRegex '.*\\.e2e-spec\\.ts$'",
    "db:migrate:dev": "DATABASE_URL=${DATABASE_URL:-mysql://root:root@localhost:3306/ibooking} prisma migrate dev",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-mysql://root:root@localhost:3306/ibooking} prisma db seed",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-mysql://root:root@localhost:3306/ibooking} prisma generate",
    "openapi:export": "ts-node -r tsconfig-paths/register src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@ibooking/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.21.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.21.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4.5"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  }
}
