.bookings-page {
  padding: 0 36rpx 160rpx;
}

.top-panel {
  margin: 0 -36rpx 28rpx;
  padding: 8rpx 36rpx 28rpx;
  background: #fafeff;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-top: 28rpx;
  overflow-x: auto;
}

.filter-chip {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  color: #4a6b64;
  font-size: 24rpx;
  font-weight: 600;
  background: #f2f7f6;
}

.filter-active {
  color: #ffffff;
  background: #2d7a6e;
}

.booking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.empty {
  padding: 44rpx 32rpx;
  color: #4a6b64;
  font-size: 26rpx;
  text-align: center;
}

.empty button {
  margin-top: 28rpx;
}

.booking-card {
  padding: 28rpx;
  border-radius: 28rpx;
}

.booking-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.booking-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.room-name {
  color: #1a2e2a;
  font-size: 26rpx;
  font-weight: 700;
}

.booking-time {
  margin-top: 4rpx;
  color: #8aaaa4;
  font-size: 22rpx;
}

.status {
  align-self: flex-start;
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.status-blue {
  color: #3a6fa8;
  background: #eef3fb;
}

.status-green {
  color: #2d9a5c;
  background: #f0faf4;
}

.status-gray {
  color: #4a6b64;
  background: #ecf4f2;
}

.status-red {
  color: #c84040;
  background: #fef2f2;
}

.seat-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.status-bg-blue {
  color: #2d7a6e;
  background: #ebf6f4;
}

.status-bg-green {
  color: #2d9a5c;
  background: #f0faf4;
}

.status-bg-gray {
  color: #4a6b64;
  background: #ecf4f2;
}

.status-bg-red {
  color: #c84040;
  background: #fef2f2;
}

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.actions.single {
  display: block;
}

.actions button {
  width: 100%;
  min-width: 0;
}

.compact {
  min-height: 76rpx;
  font-size: 26rpx;
  letter-spacing: 0;
}
