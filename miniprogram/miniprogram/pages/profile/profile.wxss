.profile-page {
  padding: 0 36rpx 160rpx;
  background: #f2f7f6;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin: 0 -36rpx 28rpx;
  padding: 48rpx 36rpx 56rpx;
  background: #1a3830;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border: 4rpx solid #d4a843;
  border-radius: 36rpx;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 950;
  background: #3d8c7e;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
}

.badge-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.identity-badge,
.credit-badge {
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.identity-badge {
  color: #2d7a6e;
  background: #ebf6f4;
}

.credit-badge {
  border: 1rpx solid rgba(212, 168, 67, 0.32);
  color: #d4a843;
  background: rgba(212, 168, 67, 0.18);
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  padding: 24rpx 12rpx;
  border: 1rpx solid #d8e8e5;
  border-radius: 24rpx;
  text-align: center;
  background: #fafeff;
}

.stat-card view {
  color: #2d7a6e;
  font-size: 40rpx;
  font-weight: 800;
}

.stat-card text {
  display: block;
  margin-top: 6rpx;
  color: #8aaaa4;
  font-size: 20rpx;
}

.menu-section {
  margin-bottom: 28rpx;
}

.menu-title {
  margin-bottom: 12rpx;
  color: #8aaaa4;
  font-size: 22rpx;
  font-weight: 600;
}

.menu-card {
  overflow: hidden;
  border: 1rpx solid #d8e8e5;
  border-radius: 28rpx;
  background: #fafeff;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #ecf4f2;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  color: #2d7a6e;
  font-size: 26rpx;
  font-weight: 900;
  background: #f2f7f6;
}

.menu-label {
  flex: 1;
  color: #1a2e2a;
  font-size: 26rpx;
  font-weight: 600;
}

.menu-sub {
  color: #8aaaa4;
  font-size: 22rpx;
}

.menu-arrow {
  color: #c8d8d5;
  font-size: 34rpx;
  font-weight: 700;
}
