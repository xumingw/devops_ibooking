.preferences-page {
  padding: 0 36rpx 160rpx;
  background: #f2f7f6;
}

.top-panel {
  margin: 0 -36rpx 28rpx;
  padding: 8rpx 36rpx 30rpx;
  background: #fafeff;
}

.panel-sub {
  display: block;
  margin-top: 8rpx;
  color: #8aaaa4;
  font-size: 22rpx;
  font-weight: 700;
}

.tab-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.tab-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  border-radius: 999rpx;
  color: #4a6b64;
  font-size: 23rpx;
  font-weight: 800;
  background: #fafeff;
  border: 1rpx solid #d8e8e5;
}

.tab-active {
  color: #ffffff;
  border-color: #2d7a6e;
  background: #2d7a6e;
}

.settings-card {
  padding: 30rpx;
  border-radius: 28rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.card-title {
  color: #1a2e2a;
  font-size: 30rpx;
  font-weight: 850;
}

.card-head text {
  display: block;
  margin-top: 8rpx;
  color: #8aaaa4;
  font-size: 23rpx;
  line-height: 1.5;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.choice-chip,
.reminder-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8e8e5;
  border-radius: 20rpx;
  color: #4a6b64;
  font-size: 25rpx;
  font-weight: 800;
  background: #f2f7f6;
}

.choice-active,
.reminder-active {
  color: #2d7a6e;
  border-color: rgba(45, 122, 110, 0.3);
  background: #ebf6f4;
}

.reminder-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.reminder-option {
  min-height: 84rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
  text-align: center;
}

.switch-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f2f7f6;
}

.switch-item > view {
  flex: 1;
  min-width: 0;
}

.switch-item > view > view {
  color: #1a2e2a;
  font-size: 26rpx;
  font-weight: 800;
}

.switch-item text {
  display: block;
  margin-top: 6rpx;
  color: #8aaaa4;
  font-size: 22rpx;
  line-height: 1.45;
}

.save-button {
  margin-top: 28rpx;
  width: 100%;
}
