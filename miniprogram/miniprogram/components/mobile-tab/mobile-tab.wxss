.tab-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  height: 160rpx;
  padding: 16rpx 0 0;
  border-top: 1rpx solid #d8e8e5;
  background: #fafeff;
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  gap: 5rpx;
  min-width: 0;
  color: #8aaaa4;
  font-size: 20rpx;
  font-weight: 400;
}

.tab-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  color: #8aaaa4;
  font-size: 36rpx;
  font-weight: 700;
}

.tab-item-active {
  color: #2d7a6e;
  font-weight: 600;
}

.tab-item-active::before {
  position: absolute;
  top: -16rpx;
  width: 48rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #2d7a6e;
  content: "";
}

.tab-item-active .tab-mark {
  color: #2d7a6e;
}
