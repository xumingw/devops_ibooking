page {
  min-height: 100vh;
  background: #f2f7f6;
  color: #1a2e2a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  max-width: 100%;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  box-sizing: border-box;
  line-height: 1.2;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  background: #f2f7f6;
}

.card {
  border: 1rpx solid #d8e8e5;
  border-radius: 20rpx;
  background: #fafeff;
  box-shadow: 0 8rpx 28rpx rgba(26, 56, 48, 0.08);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 24rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #2d7a6e, #3d8c7e);
  box-shadow: 0 10rpx 28rpx rgba(45, 122, 110, 0.24);
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 76rpx;
  padding: 0 24rpx;
  color: #2d7a6e;
  font-size: 26rpx;
  font-weight: 700;
  border: 1rpx solid #d8e8e5;
  background: #fafeff;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a2e2a;
}

.muted {
  color: #8aaaa4;
}

.badge {
  display: inline-flex;
  align-items: center;
  min-height: 36rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #2d7a6e;
  font-size: 22rpx;
  font-weight: 700;
  background: #ebf6f4;
}

.badge-gold {
  color: #8b6520;
  background: #fdf6e0;
}

.badge-green {
  color: #2d9a5c;
  background: #f0faf4;
}

.badge-red {
  color: #c84040;
  background: #fef2f2;
}

.field {
  display: block;
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.1);
}
