# DB & infra
DATABASE_URL=mysql://root:root@localhost:3306/ibooking
REDIS_URL=redis://localhost:6379

# Auth
# Production must set a long random value; local development falls back when empty.
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

# Mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ibooking@example.com

# Business rules
MAX_BOOK_HOURS=4
BOOK_GRANULARITY_MINUTES=60
REMINDER_BEFORE_MINUTES=15
LATE_REMINDER_AFTER_MINUTES=10
AUTO_CANCEL_AFTER_MINUTES=15
ROOM_DEFAULT_OPEN_HOUR=7
ROOM_DEFAULT_CLOSE_HOUR=22

# AI assistant
LLM_PROVIDER=bigmodel
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
LLM_BASE_URL=https://open.bigmodel.cn
LLM_TIMEOUT_MS=15000
BIGMODEL_API_KEY=
BIGMODEL_MODEL=glm-4.7-flash
BIGMODEL_BASE_URL=https://open.bigmodel.cn
BIGMODEL_TIMEOUT_MS=15000

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# QR code signing
QRCODE_HMAC_SECRET=change-me
